.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 80rpx;
}

/* 标题 */
.header {
  padding: 24rpx 8rpx 32rpx;
}
.title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

/* 输入卡片 */
.input-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.input {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--text);
}
.input-ph {
  color: #5b616e;
}
.input-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.link-btn {
  font-size: 28rpx;
  color: var(--primary-2);
}

/* 提取按钮 */
.extract-btn {
  margin-top: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, var(--primary), #7b5cff);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
}
.extract-btn.disabled {
  opacity: 0.6;
}
.extract-btn::after {
  border: none;
}

/* 平台标签 */
.platforms {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 4rpx;
}
.tag {
  font-size: 24rpx;
  color: var(--text-2);
  background: var(--card-2);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

/* 结果区 */
.result {
  margin-top: 16rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.result-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.result-platform {
  font-size: 26rpx;
  color: #fff;
  background: var(--primary);
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}
.result-type {
  font-size: 24rpx;
  color: var(--text-2);
}
.result-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
}
.result-author {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.video {
  width: 100%;
  height: 420rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #000;
}

/* 图文 */
.image-list {
  white-space: nowrap;
  margin-top: 24rpx;
}
.image-item {
  display: inline-block;
  width: 240rpx;
  height: 320rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
}
.note {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #ffb454;
  line-height: 1.5;
}

/* 操作按钮 */
.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.action-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  border: none;
}
.action-btn::after {
  border: none;
}
.action-btn.primary {
  background: var(--primary);
  color: #fff;
}
.action-btn.ghost {
  background: var(--card-2);
  color: var(--text);
}

/* 使用说明 */
.tips {
  margin-top: 40rpx;
  padding: 0 8rpx;
}
.tips-title {
  font-size: 28rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
}
.tips-item {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.9;
}
.tips-item.disclaimer {
  margin-top: 16rpx;
  color: #6b7280;
}

/* 底部 Banner 广告 */
.banner-wrap {
  margin-top: 40rpx;
}
